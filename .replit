modules = ["nodejs-24", "python-base-3.13", "dotnet-8.0", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "vm"
ignorePorts = false

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
BLACKTHORN_BASE_URL = "https://blackthorn-manor.replit.app"
MEMORY_EXPECTED_DB_HOST = "primary.stillwater-db--hb8nhtvw6kzc.addon.code.run"
MEMORY_ALLOW_INIT = "false"
MEMORY_HOUSE_NAME = "Stillwater"

[userenv.development]
MEMORY_CAPTURE_ENABLED = "false"

[userenv.production]
MEMORY_CAPTURE_ENABLED = "true"
