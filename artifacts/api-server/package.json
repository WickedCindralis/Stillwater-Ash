{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build:companion": "sh ../../desktop-companion/build-windows.sh",
    "build": "pnpm run build:companion && node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:discord": "esbuild ./src/lib/ash/discord-policy.test.ts --bundle --platform=node --format=esm --outfile=/tmp/stillwater-discord-policy.test.mjs && node --test /tmp/stillwater-discord-policy.test.mjs && esbuild ./src/lib/ash/discord-storage.integration.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/stillwater-discord-storage.integration.test.cjs && node --test /tmp/stillwater-discord-storage.integration.test.cjs",
    "test:chronicle": "esbuild ./src/lib/ash/chronicle-format.test.ts --bundle --platform=node --format=esm --outfile=/tmp/stillwater-chronicle-format.test.mjs && node --test /tmp/stillwater-chronicle-format.test.mjs",
    "test:screen-capture": "esbuild ./src/lib/ash/screen-capture.integration.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/stillwater-screen-capture.integration.test.cjs && node --test /tmp/stillwater-screen-capture.integration.test.cjs",
    "test:screen-command": "esbuild ./src/lib/ash/screen-capture-command.test.ts --bundle --platform=node --format=esm --outfile=/tmp/stillwater-screen-capture-command.test.mjs && node --test /tmp/stillwater-screen-capture-command.test.mjs",
    "test:history": "esbuild ./src/lib/ash/history-format.test.ts --bundle --platform=node --format=esm --outfile=/tmp/stillwater-history-format.test.mjs && node --test /tmp/stillwater-history-format.test.mjs",
    "test:doors": "esbuild ./src/lib/ash/door-command.test.ts --bundle --platform=node --format=esm --outfile=/tmp/stillwater-door-command.test.mjs && node --test /tmp/stillwater-door-command.test.mjs",
    "test:story-command": "esbuild ./src/lib/ash/story-command.test.ts --bundle --platform=node --format=esm --outfile=/tmp/stillwater-story-command.test.mjs",
    "test:hangout-policy": "esbuild ./src/lib/ash/hangout-policy.test.ts --bundle --platform=node --format=esm --outfile=/tmp/stillwater-hangout-policy.test.mjs && node --test /tmp/stillwater-hangout-policy.test.mjs",
    "test:hangout-integration": "node ./run-hangout-integration.mjs",
    "memory:migrate": "tsx vector-memory/src/migrate.ts",
    "memory:test-scoring": "tsx vector-memory/test/scoring.test.ts",
    "memory:smoke": "tsx vector-memory/test/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "chess.js": "^1.4.0",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "discord.js": "^14.25.1",
    "docx": "^9.7.1",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "openai": "^6.45.0",
    "pg": "^8.22.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
